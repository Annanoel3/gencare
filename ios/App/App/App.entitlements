<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- The app's own keychain group stays first (where its items go by default);
	     the .shared group holds the home-screen widgets' key, which the
	     GenCareWidgets extension reads (WidgetBridge.swift). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.mediocreatbest.gencare</string>
		<string>$(AppIdentifierPrefix)com.mediocreatbest.gencare.shared</string>
	</array>
</dict>
</plist>
