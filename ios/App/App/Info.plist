<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>GenCare</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Taps on the home-screen widgets: gencare://open?path=/calendar?date=... -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mediocreatbest.gencare.widgets</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gencare</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>GenCare uses the camera only when you choose to take a photo to add to a message, a note or the care log.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GenCare opens your photos only when you choose one to add to a message, a note or the care log.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>GenCare records appointments and meetings so it can write notes for you. Audio stays on your phone until it is sent for transcription.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>GenCare can bring events from your calendars into the family calendar, and put family events on your calendar, when you turn that on.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>GenCare can bring events from your calendars into the family calendar, and put family events on your calendar, when you turn that on.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>GenCare can put family events on your calendar when you turn that on.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<!-- Calendar sync with the app closed (BackgroundSync.swift). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.mediocreatbest.gencare.calendar-sync</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>RCAppleApiKey</key>
	<string>$(RC_APPLE_KEY)</string>
	<key>GenCareAppStoreId</key>
	<string>$(GENCARE_APP_STORE_ID)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
