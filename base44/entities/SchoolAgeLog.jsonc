{
  "name": "SchoolAgeLog",
  "properties": {
    "completed": {
      "default": false,
      "type": "boolean"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "entry_type": {
      "default": "reading",
      "enum": [
        "reading",
        "homework",
        "chore",
        "hygiene",
        "mood",
        "screen_time",
        "activity"
      ],
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the school-age child",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "hygiene_habit": {
      "enum": [
        "shower",
        "teeth",
        "bedtime"
      ],
      "type": "string"
    },
    "minutes": {
      "description": "Reading, screen, or activity minutes",
      "type": "number"
    },
    "mood": {
      "enum": [
        "happy",
        "calm",
        "anxious",
        "irritable",
        "upset"
      ],
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "stars": {
      "description": "Reward stars earned for a chore",
      "type": "number"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "description": "Book title, assignment, chore, or activity name",
      "type": "string"
    }
  },
  "required": [
    "family_member_id",
    "entry_type"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}