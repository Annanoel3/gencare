{
  "name": "TeenLog",
  "properties": {
    "amount": {
      "description": "Dollar amount for financial entries",
      "type": "number"
    },
    "contact": {
      "description": "Driver or other parent contact",
      "type": "string"
    },
    "date": {
      "description": "Deadline, pickup, or event date",
      "format": "date",
      "type": "string"
    },
    "doc_url": {
      "description": "Link to a stored document",
      "type": "string"
    },
    "entry_type": {
      "default": "transport",
      "enum": [
        "transport",
        "financial",
        "document",
        "academic"
      ],
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the teen",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "scheduled",
        "done"
      ],
      "type": "string"
    },
    "sub_type": {
      "description": "Specific kind within the entry type",
      "type": "string"
    },
    "time": {
      "description": "Pickup or drop-off time",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "family_member_id",
    "entry_type"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}