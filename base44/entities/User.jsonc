{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "invite_code_used": {
      "type": "string",
      "description": "The invite code the user used when joining a family"
    }
  }
}