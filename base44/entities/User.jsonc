{
  "name": "User",
  "properties": {
    "app_build": {
      "description": "Build number of the phone app last seen on this account (Android versionCode or iPhone build); 0/unset = website",
      "type": "number"
    },
    "device_calendar_ids": {
      "description": "Phone calendars (Android provider ids) this person imports into GenCare",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "digest_sent_on": {
      "description": "YYYY-MM-DD the morning digest last went out",
      "type": "string"
    },
    "display_name": {
      "description": "How this person is shown to the family",
      "type": "string"
    },
    "event_sharing_default": {
      "description": "Who sees the events this person adds or brings in from their phone: auto = GenCare decides per event, family = everyone, private = only them. Unset = not chosen yet (asked on the Calendar page)",
      "enum": [
        "auto",
        "family",
        "private"
      ],
      "type": "string"
    },
    "export_calendar_id": {
      "description": "The phone calendar (provider id) GenCare writes into",
      "type": "string"
    },
    "export_categories": {
      "description": "Only these categories go to the phone; empty = all",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "export_enabled": {
      "default": false,
      "description": "Write family events into this person's phone calendar",
      "type": "boolean"
    },
    "export_member_ids": {
      "description": "Only events for these family members go to the phone; empty = everyone",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "export_reminder_minutes": {
      "default": 30,
      "description": "Reminder set on exported phone events; -1 for none",
      "type": "number"
    },
    "family_id": {
      "description": "The Family this person belongs to; every family-scoped record carries the same id",
      "type": "string"
    },
    "family_role": {
      "default": "member",
      "enum": [
        "owner",
        "member"
      ],
      "type": "string"
    },
    "help_zip": {
      "description": "This person's home ZIP code (optional): place search and Resources lean toward it; asked in the welcome chat",
      "type": "string"
    },
    "welcome_done_at": {
      "description": "When this person finished or closed the welcome chat (so it never shows again on another phone)",
      "type": "string",
      "format": "date-time"
    },
    "import_share_calendar_ids": {
      "description": "Of the imported phone calendars, which ones are shared with the family (the rest stay private)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "invite_code_used": {
      "description": "The invite code the user used when joining a family",
      "type": "string"
    },
    "last_os": {
      "description": "Phone system and version last seen, e.g. iOS 18.1",
      "type": "string"
    },
    "last_platform": {
      "description": "Where they last opened GenCare: ios (iPhone app), android (Android app) or web (a browser)",
      "enum": [
        "ios",
        "android",
        "web"
      ],
      "type": "string"
    },
    "last_seen_at": {
      "description": "When they last opened GenCare",
      "format": "date-time",
      "type": "string"
    },
    "messages_seen_at": {
      "description": "When this person last opened Messages (unread badge)",
      "format": "date-time",
      "type": "string"
    },
    "notify_family_events": {
      "default": true,
      "description": "Push when a family member adds or changes a shared event",
      "type": "boolean"
    },
    "notify_reminders": {
      "default": true,
      "description": "Push reminders before appointments and for due tasks",
      "type": "boolean"
    },
    "onesignal_player_id": {
      "description": "OneSignal subscription id of this person's phone",
      "type": "string"
    },
    "push_enabled": {
      "default": true,
      "type": "boolean"
    },
    "role": {
      "default": "user",
      "enum": [
        "admin",
        "user"
      ],
      "type": "string"
    },
    "timezone": {
      "description": "IANA timezone, e.g. America/Chicago",
      "type": "string"
    },
    "wellness_reminded_on": {
      "description": "YYYY-MM-DD the wellness reminder last went out",
      "type": "string"
    },
    "wellness_reminder_hour": {
      "description": "Local hour (0-23) for the daily 'how are you holding up?' push; null = off",
      "type": "number"
    }
  },
  "required": [],
  "type": "object"
}