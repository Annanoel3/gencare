{
  "name": "CareTask",
  "properties": {
    "assigned_to": {
      "description": "Name of the person assigned",
      "type": "string"
    },
    "assigned_user_id": {
      "description": "The GenCare account the task is assigned to",
      "type": "string"
    },
    "category": {
      "default": "Other",
      "enum": [
        "Medical",
        "School",
        "Grocery",
        "Household",
        "Transportation",
        "Financial",
        "Personal Care",
        "Other"
      ],
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "completed_by_user_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "due_time": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_recurring": {
      "default": false,
      "description": "True when recurrence is set to something other than none (kept for older rows)",
      "type": "boolean"
    },
    "kind": {
      "default": "task",
      "description": "checklist = a routine made of steps anyone in the family ticks off (feed the fish, morning meds); it comes back on its own rhythm",
      "enum": [
        "task",
        "checklist"
      ],
      "type": "string"
    },
    "next_occurrence_id": {
      "description": "The copy that finishing this repeating task made, so un-finishing removes exactly that one",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "parent_task_id": {
      "description": "Set on a step (sub-task) of another task; steps are never shown as tasks of their own",
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "type": "string"
    },
    "recurrence": {
      "default": "none",
      "description": "How often the task comes back after it is finished. Finishing it makes the next copy (next_occurrence_id).",
      "enum": [
        "none",
        "daily",
        "every_other_day",
        "weekdays",
        "weekly",
        "every_other_week",
        "monthly",
        "yearly"
      ],
      "type": "string"
    },
    "recurrence_days": {
      "description": "With recurrence weekly: the weekdays it repeats on, 0 = Sunday",
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "reminder_sent_at": {
      "description": "When the due-time push went out, so it goes once",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "subtask_order": {
      "description": "Position of a step inside its parent, 1 = first",
      "type": "number"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}