{
  "name": "CareTask",
  "properties": {
    "assigned_to": {
      "description": "Name of the person assigned",
      "type": "string"
    },
    "assigned_user_id": {
      "description": "The GenCare account the task is assigned to",
      "type": "string"
    },
    "category": {
      "default": "Other",
      "enum": [
        "Medical",
        "School",
        "Grocery",
        "Household",
        "Transportation",
        "Financial",
        "Personal Care",
        "Other"
      ],
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "due_time": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_recurring": {
      "default": false,
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "type": "string"
    },
    "recurrence": {
      "default": "daily",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}