{
  "name": "Invite",
  "properties": {
    "code": {
      "description": "Unique invite code",
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_user_id": {
      "description": "Account that made the invite (never linked to the profile by its own link)",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "The profile (FamilyMember) this invite is for; whoever joins with it becomes that profile (linked_user_id)",
      "type": "string"
    },
    "family_member_name": {
      "description": "That profile's name, shown on the join page",
      "type": "string"
    },
    "family_name": {
      "description": "Display name shown to the invitee",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "uses_count": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "code"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  }
}