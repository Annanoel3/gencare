{
  "name": "Invite",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique invite code"
    },
    "family_name": {
      "type": "string",
      "description": "Display name shown to the invitee"
    },
    "created_by_name": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "uses_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code"
  ]
}