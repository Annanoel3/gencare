{
  "name": "Invite",
  "properties": {
    "code": {
      "description": "Unique invite code",
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_name": {
      "description": "Display name shown to the invitee",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "uses_count": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}