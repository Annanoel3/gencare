{
  "name": "ChecklistItem",
  "type": "object",
  "properties": {
    "checklist_id": {
      "type": "string",
      "description": "Parent checklist ID"
    },
    "label": {
      "type": "string",
      "description": "The item text, e.g. Take morning pill"
    },
    "is_checked": {
      "type": "boolean",
      "default": false
    },
    "checked_by": {
      "type": "string",
      "description": "Name of who checked it off"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_reset_date": {
      "type": "string",
      "format": "date",
      "description": "Date the item was last reset"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "checklist_id",
    "label"
  ]
}