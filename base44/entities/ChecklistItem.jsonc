{
  "name": "ChecklistItem",
  "properties": {
    "checked_at": {
      "format": "date-time",
      "type": "string"
    },
    "checked_by": {
      "description": "Name of who checked it off",
      "type": "string"
    },
    "checklist_id": {
      "description": "Parent checklist ID",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "is_checked": {
      "default": false,
      "type": "boolean"
    },
    "label": {
      "description": "The item text, e.g. Take morning pill",
      "type": "string"
    },
    "last_reset_date": {
      "description": "Date the item was last reset",
      "format": "date",
      "type": "string"
    },
    "sort_order": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "checklist_id",
    "label"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}