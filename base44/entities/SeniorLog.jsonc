{
  "name": "SeniorLog",
  "properties": {
    "amount": {
      "type": "number"
    },
    "date": {
      "description": "Refill date or appointment date",
      "format": "date",
      "type": "string"
    },
    "doc_url": {
      "description": "Link to a stored legal/medical document",
      "type": "string"
    },
    "entry_type": {
      "default": "care_log",
      "enum": [
        "care_log",
        "legal",
        "medication",
        "cognitive"
      ],
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the senior family member",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "given_by": {
      "description": "Who provided the care (aide, nurse, family)",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "pharmacy": {
      "type": "string"
    },
    "sub_type": {
      "description": "Specific kind within the entry type",
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "vitals": {
      "description": "Recorded vitals, e.g. BP 120/80",
      "type": "string"
    }
  },
  "required": [
    "family_member_id",
    "entry_type"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}