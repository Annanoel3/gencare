{
  "name": "SeniorLog",
  "type": "object",
  "properties": {
    "family_member_id": {
      "type": "string",
      "description": "ID of the senior family member"
    },
    "family_member_name": {
      "type": "string"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "care_log",
        "legal",
        "medication",
        "cognitive"
      ],
      "default": "care_log"
    },
    "sub_type": {
      "type": "string",
      "description": "Specific kind within the entry type"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Refill date or appointment date"
    },
    "time": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "given_by": {
      "type": "string",
      "description": "Who provided the care (aide, nurse, family)"
    },
    "vitals": {
      "type": "string",
      "description": "Recorded vitals, e.g. BP 120/80"
    },
    "pharmacy": {
      "type": "string"
    },
    "doc_url": {
      "type": "string",
      "description": "Link to a stored legal/medical document"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "family_member_id",
    "entry_type"
  ]
}