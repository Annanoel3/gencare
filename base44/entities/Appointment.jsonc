{
  "name": "Appointment",
  "properties": {
    "ai_care": {
      "description": "GenCare's read: part of looking after someone (health, therapy, doctor or vet visits, medicine, caregiver help). Care events are colored on the calendar; the rest show as plain text",
      "type": "boolean"
    },
    "ai_checked_at": {
      "description": "When GenCare last sorted this event (who it's about, shared or not, category)",
      "format": "date-time",
      "type": "string"
    },
    "ai_cover": {
      "description": "GenCare's read: a private event of the person's own the family should still know about, shown to them only as this plain label (e.g. 'doctor', 'appointment')",
      "type": "string"
    },
    "ai_share": {
      "description": "GenCare's sharing pick for this event (used when the person's choice is 'GenCare decides')",
      "type": "boolean"
    },
    "ai_sort_v": {
      "description": "Which version of GenCare's sorting rules last sorted this event; an older one is sorted again on the next sync",
      "type": "number"
    },
    "ai_trip": {
      "description": "GenCare's read: part of the person's own trip away from home (flights, stays, events while away). Their trips show the family one '<name> traveling' event instead",
      "type": "boolean"
    },
    "all_day": {
      "default": false,
      "type": "boolean"
    },
    "auto_set": {
      "description": "Fields GenCare filled in itself (visibility, member, category); a person's own pick is never in here and never overridden",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "away_of": {
      "description": "Set on a '<name> traveling' event GenCare made from that user's trips (their user id); kept in step with their trips",
      "type": "string"
    },
    "care": {
      "description": "The person's own pick of whether this is care-related, made in the event (Anna, Oct 30 2026: in case GenCare got it wrong). When set it wins over ai_care; GenCare's sorting never changes it",
      "type": "boolean"
    },
    "category": {
      "default": "Appointment",
      "enum": [
        "Appointment",
        "School",
        "Work",
        "Sports",
        "Social",
        "Other"
      ],
      "type": "string"
    },
    "claim_changed_at": {
      "description": "When someone last said I'll take it, or let go, on this (Who did what reads it)",
      "format": "date-time",
      "type": "string"
    },
    "claims": {
      "description": "\"I'll take it\": who said they'd handle it. One entry per day for something that repeats (day = YYYY-MM-DD), or one with an empty day for the whole thing. Their reminders go to them",
      "items": {
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "day": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "cover_of": {
      "description": "Set on a '<name>: doctor' style event GenCare made so the family sees that a private event is happening without its details; the private event's id",
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "device_key": {
      "description": "For phone imports: <user id>:<calendar id>:<event id>, so the same event is never imported twice",
      "type": "string"
    },
    "doctor_name": {
      "description": "Who the event is with (shown as 'With')",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "last_changed_at": {
      "format": "date-time",
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "notes_record_id": {
      "description": "NoteRecording made for this appointment",
      "type": "string"
    },
    "phone_location": {
      "description": "The place as the phone calendar last had it (sync uses it to tell a phone change from one typed here)",
      "type": "string"
    },
    "phone_notes": {
      "description": "The notes as the phone calendar last had them",
      "type": "string"
    },
    "prep_questions": {
      "description": "Things to bring up at this appointment, written beforehand on the Record Notes page",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "recurrence": {
      "description": "RRULE for repeating events",
      "type": "string"
    },
    "reminder_minutes": {
      "default": 60,
      "description": "Push reminder this many minutes before; -1 for none",
      "type": "number"
    },
    "reminder_sent": {
      "default": false,
      "type": "boolean"
    },
    "reminder_sent_for": {
      "description": "For a repeating event: the day (YYYY-MM-DD) whose occurrence was last reminded about, so each day's reminder goes once",
      "type": "string"
    },
    "shared_with": {
      "description": "User ids this event is shared with when visibility is 'some'",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source": {
      "default": "app",
      "description": "phone = imported from a phone calendar",
      "enum": [
        "app",
        "phone"
      ],
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "visibility": {
      "default": "family",
      "description": "family = everyone in the family; some = only the accounts in shared_with; private = only the person who added it",
      "enum": [
        "family",
        "some",
        "private"
      ],
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": "family"
            },
            {
              "data.shared_with": "{{user.id}}"
            },
            {
              "data.created_by_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  }
}