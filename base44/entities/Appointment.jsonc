{
  "name": "Appointment",
  "properties": {
    "all_day": {
      "default": false,
      "type": "boolean"
    },
    "category": {
      "default": "Doctor",
      "enum": [
        "Doctor",
        "Therapy",
        "School",
        "Sports",
        "Social",
        "Other"
      ],
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "device_key": {
      "description": "For phone imports: <user id>:<calendar id>:<event id>, so the same event is never imported twice",
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "last_changed_at": {
      "format": "date-time",
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "notes_record_id": {
      "description": "NoteRecording made for this appointment",
      "type": "string"
    },
    "prep_questions": {
      "description": "Things to bring up at this appointment, written beforehand on the Record Notes page",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "recurrence": {
      "description": "RRULE for repeating events",
      "type": "string"
    },
    "reminder_minutes": {
      "default": 60,
      "description": "Push reminder this many minutes before; -1 for none",
      "type": "number"
    },
    "reminder_sent": {
      "default": false,
      "type": "boolean"
    },
    "shared_with": {
      "description": "User ids this event is shared with when visibility is 'some'",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source": {
      "default": "app",
      "description": "phone = imported from a phone calendar",
      "enum": [
        "app",
        "phone"
      ],
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "visibility": {
      "default": "family",
      "description": "family = everyone in the family; some = only the accounts in shared_with; private = only the person who added it",
      "enum": [
        "family",
        "some",
        "private"
      ],
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": "family"
            },
            {
              "data.shared_with": "{{user.id}}"
            },
            {
              "data.created_by_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}