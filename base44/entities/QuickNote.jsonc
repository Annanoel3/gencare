{
  "name": "QuickNote",
  "properties": {
    "ai_category": {
      "type": "string"
    },
    "ai_summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_processed": {
      "default": false,
      "type": "boolean"
    },
    "type": {
      "default": "text",
      "enum": [
        "voice",
        "text",
        "photo"
      ],
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}