{
  "name": "ToddlerCareLog",
  "properties": {
    "entry_type": {
      "default": "mood",
      "enum": [
        "tantrum",
        "mood",
        "screen_time",
        "potty",
        "milestone"
      ],
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the toddler",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "milestone_category": {
      "enum": [
        "speech",
        "motor",
        "social"
      ],
      "type": "string"
    },
    "milestone_description": {
      "type": "string"
    },
    "mood": {
      "enum": [
        "happy",
        "calm",
        "anxious",
        "irritable",
        "upset"
      ],
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "potty_type": {
      "enum": [
        "attempt",
        "success",
        "accident"
      ],
      "type": "string"
    },
    "screen_time_min": {
      "type": "number"
    },
    "tantrum_duration_min": {
      "type": "number"
    },
    "tantrum_response": {
      "description": "How it was handled",
      "type": "string"
    },
    "tantrum_trigger": {
      "description": "What triggered the tantrum",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "family_member_id",
    "entry_type"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}