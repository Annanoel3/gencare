{
  "name": "BabyCareLog",
  "properties": {
    "amount_ml": {
      "type": "number"
    },
    "breast_side": {
      "enum": [
        "left",
        "right",
        "both"
      ],
      "type": "string"
    },
    "diaper_type": {
      "enum": [
        "wet",
        "dirty",
        "mixed"
      ],
      "type": "string"
    },
    "duration_min": {
      "type": "number"
    },
    "entry_type": {
      "default": "feeding",
      "enum": [
        "feeding",
        "diaper",
        "sleep",
        "pumping"
      ],
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the baby",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "feeding_method": {
      "enum": [
        "nursing",
        "bottle",
        "solid"
      ],
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sleep_type": {
      "enum": [
        "nap",
        "night"
      ],
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "family_member_id",
    "entry_type"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}