{
  "name": "FamilyMember",
  "properties": {
    "allergies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "birthdate": {
      "format": "date",
      "type": "string"
    },
    "blood_type": {
      "type": "string"
    },
    "care_notes": {
      "description": "Important info: anything the family should know about this person",
      "type": "string"
    },
    "color": {
      "description": "Profile color code",
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "insurance_policy_number": {
      "type": "string"
    },
    "insurance_provider": {
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "linked_user_id": {
      "description": "The GenCare account this family member is, if they use the app themselves",
      "type": "string"
    },
    "medical_conditions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "description": "Full name",
      "type": "string"
    },
    "other_contact_name": {
      "description": "Another contact for this person (neighbor, coach, babysitter)",
      "type": "string"
    },
    "other_contact_phone": {
      "description": "That contact's phone number",
      "type": "string"
    },
    "photo_url": {
      "description": "Profile photo URL",
      "type": "string"
    },
    "preferred_pharmacy": {
      "type": "string"
    },
    "primary_doctor": {
      "type": "string"
    },
    "primary_doctor_phone": {
      "type": "string"
    },
    "relationship": {
      "description": "Relationship to the user",
      "enum": [
        "Mother",
        "Father",
        "Grandmother",
        "Grandfather",
        "Son",
        "Daughter",
        "Spouse",
        "Sibling",
        "Uncle",
        "Aunt",
        "Cousin",
        "Foster Child",
        "Other"
      ],
      "type": "string"
    },
    "school_grade": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "school_phone": {
      "type": "string"
    },
    "school_teacher": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "relationship"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  }
}