{
  "name": "CareJournal",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "category": {
      "default": "General",
      "enum": [
        "Symptom",
        "Behavior",
        "Mood",
        "Doctor Note",
        "Observation",
        "Milestone",
        "General"
      ],
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_important": {
      "default": false,
      "type": "boolean"
    },
    "mood": {
      "enum": [
        "great",
        "good",
        "okay",
        "poor",
        "bad"
      ],
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}