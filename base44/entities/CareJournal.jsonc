{
  "name": "CareJournal",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_user_id": {
      "description": "Account that wrote the entry",
      "type": "string"
    },
    "category": {
      "default": "General",
      "enum": [
        "Observation",
        "Appointment",
        "Behavior",
        "Mood",
        "Milestone",
        "General"
      ],
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "entry_date": {
      "description": "The day the entry is about (defaults to the day it was written)",
      "format": "date",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_important": {
      "default": false,
      "type": "boolean"
    },
    "mood": {
      "enum": [
        "great",
        "good",
        "okay",
        "poor",
        "bad"
      ],
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "photos": {
      "description": "Private file URIs; shown through short-lived signed URLs",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "content"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  }
}