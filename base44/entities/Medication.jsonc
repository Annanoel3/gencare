{
  "name": "Medication",
  "properties": {
    "days_of_week": {
      "description": "Weekdays the doses happen on, 0 = Sunday; empty = every day",
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "dosage": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the family member",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "frequency": {
      "enum": [
        "Once daily",
        "Twice daily",
        "Three times daily",
        "Four times daily",
        "Weekly",
        "Bi-weekly",
        "Monthly",
        "As needed"
      ],
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "medication_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "pharmacy": {
      "type": "string"
    },
    "prescribing_doctor": {
      "type": "string"
    },
    "refill_date": {
      "format": "date",
      "type": "string"
    },
    "refill_reminded_on": {
      "description": "The day the refill push last went out, so it goes once a day",
      "type": "string"
    },
    "refill_reminder_days": {
      "default": 3,
      "description": "Push about the refill this many days before refill_date",
      "type": "number"
    },
    "remind": {
      "default": true,
      "description": "Dose pushes on/off",
      "type": "boolean"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "times": {
      "description": "Dose times, HH:MM in the family's own time (08:00, 20:00). Each gets a push and a Taken button; empty = no dose reminders",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "medication_name",
    "family_member_id"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}