{
  "description": "Reminders page: things the family does at set times. (Table name kept from when the page was a medication list.)",
  "name": "Medication",
  "properties": {
    "anchor_time": {
      "description": "For an \"until it's done\" reminder: when it starts on its first day (HH:MM, 8 AM to 8 PM); the other push times are worked out from it and the priority",
      "type": "string"
    },
    "days_of_week": {
      "description": "Weekdays it happens on, 0 = Sunday; empty = every day",
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "dosage": {
      "description": "Details, shown next to the name (1 scoop)",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "Who it is for (optional)",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "frequency": {
      "description": "Once = until it's done (keeps reminding by priority until someone marks it done). One time = one push at its time on once_date, and that's all. The rest repeat at times[]",
      "enum": [
        "Once",
        "One time",
        "Once daily",
        "Twice daily",
        "Three times daily",
        "Four times daily",
        "Weekly",
        "Bi-weekly",
        "Monthly",
        "As needed"
      ],
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "medication_name": {
      "description": "What to remind the family about (feed the dog, water the plants)",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "once_date": {
      "description": "For Once (until it's done): the day it starts. For One time: the day it happens",
      "format": "date",
      "type": "string"
    },
    "owner_user_id": {
      "description": "Account that added it; for a private reminder, the only person who sees it and gets its push",
      "type": "string"
    },
    "priority": {
      "description": "For an \"until it's done\" reminder: how often it nags until someone marks it done. low = once a day at its time, medium = 3 times a day, high = every 2 hours from 8 AM to 8 PM (times holds the resulting push times)",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "refill_date": {
      "description": "Runs-out date for things that need restocking",
      "format": "date",
      "type": "string"
    },
    "refill_reminded_on": {
      "description": "The day the runs-out push last went out, so it goes once a day",
      "type": "string"
    },
    "refill_reminder_days": {
      "default": 3,
      "description": "Push about running out this many days before refill_date",
      "type": "number"
    },
    "remind": {
      "default": true,
      "description": "Pushes at each time on/off",
      "type": "boolean"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "times": {
      "description": "Times, HH:MM in the family's own time (08:00, 20:00). Each gets a push and a Done button",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "visibility": {
      "default": "family",
      "description": "family = everyone in the family sees it and gets the push; private = only owner_user_id (\"Just me\")",
      "enum": [
        "family",
        "private"
      ],
      "type": "string"
    }
  },
  "required": [
    "medication_name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": {
                "$nin": [
                  "private"
                ]
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": {
                "$nin": [
                  "private"
                ]
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": {
                "$nin": [
                  "private"
                ]
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}