{
  "name": "Medication",
  "properties": {
    "dosage": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the family member",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "frequency": {
      "default": "Once daily",
      "enum": [
        "Once daily",
        "Twice daily",
        "Three times daily",
        "Four times daily",
        "Weekly",
        "Bi-weekly",
        "Monthly",
        "As needed"
      ],
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "medication_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "pharmacy": {
      "type": "string"
    },
    "prescribing_doctor": {
      "type": "string"
    },
    "refill_date": {
      "format": "date",
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "medication_name",
    "family_member_id"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}