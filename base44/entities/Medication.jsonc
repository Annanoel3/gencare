{
  "description": "Reminders page: things the family does at set times. (Table name kept from when the page was a medication list.)",
  "name": "Medication",
  "properties": {
    "anchor_time": {
      "description": "For an \"until it's done\" reminder: when it starts on its first day (HH:MM). The time picked on the form (Nov 19 2026); one added without a time starts at the next full hour, 8 AM to 8 PM. The other push times are worked out from it, the priority and end_time",
      "type": "string"
    },
    "claim_changed_at": {
      "description": "When someone last said I'll take it, or let go, on this (Who did what reads it)",
      "format": "date-time",
      "type": "string"
    },
    "claims": {
      "description": "\"I'll take it\": who said they'd handle it. One entry per day for something that repeats (day = YYYY-MM-DD), or one with an empty day for the whole thing. Their reminders go to them",
      "items": {
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "day": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "custom_times": {
      "description": "For an \"until it's done\" reminder: true when the person set its push times themselves on the form (Anna, Nov 25 2026), so times holds exactly those and isn't worked out from priority. False or missing = times come from priority, anchor_time and end_time",
      "type": "boolean"
    },
    "days_of_week": {
      "description": "Weekdays it happens on, 0 = Sunday; empty = every day",
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "dosage": {
      "description": "Details, shown next to the name (1 scoop)",
      "type": "string"
    },
    "end_date": {
      "description": "For a repeating reminder (every day / certain days): the last day it reminds. Empty = no end picked (\"Until I stop it\"); Stop repeating sets it to that day",
      "format": "date",
      "type": "string"
    },
    "end_time": {
      "description": "A one-off to-do's end time, HH:MM (Anna, Nov 19 2026: \"pick up dry cleaning from 3-5 p.m.\"). One time: shown as the range, one push at the start. Until it's done: its pushes stay inside the range (the start, its priority's usual ones, and a last one 30 minutes before the end), and not done by then it comes back the next day in the same range. Empty = no end time",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "Who it is for (optional); with more than one, the first of family_member_ids",
      "type": "string"
    },
    "family_member_ids": {
      "description": "Everyone it's for, people and pets (Nov 14 2026); family_member_name reads \"Peach and Kaiju\"",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "family_member_name": {
      "type": "string"
    },
    "frequency": {
      "description": "Once = until it's done (keeps reminding by priority until someone marks it done). One time = one push at its time on once_date, and that's all. The rest repeat at times[]",
      "enum": [
        "Once",
        "One time",
        "Once daily",
        "Twice daily",
        "Three times daily",
        "Four times daily",
        "Weekly",
        "Bi-weekly",
        "Monthly",
        "As needed"
      ],
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "medication_name": {
      "description": "What to remind the family about (feed the dog, water the plants)",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "once_date": {
      "description": "For Once (until it's done): the day it starts. For One time: the day it happens",
      "format": "date",
      "type": "string"
    },
    "owner_user_id": {
      "description": "Account that added it; for a private reminder, the only person who sees it and gets its push",
      "type": "string"
    },
    "priority": {
      "description": "For an \"until it's done\" reminder: how often it nags until someone marks it done. low = once a day at its time, medium = 3 times a day, high = every 2 hours from 8 AM to 8 PM (times holds the resulting push times)",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "refill_date": {
      "description": "Runs-out date for things that need restocking",
      "format": "date",
      "type": "string"
    },
    "refill_reminded_on": {
      "description": "The day the runs-out push last went out, so it goes once a day",
      "type": "string"
    },
    "refill_reminder_days": {
      "default": 3,
      "description": "Push about running out this many days before refill_date",
      "type": "number"
    },
    "remind": {
      "default": true,
      "description": "Pushes at each time on/off",
      "type": "boolean"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "steps": {
      "description": "Steps to tick off, like a checklist (Anna, Nov 14 2026). Optional. Ticking the last one marks it done",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "steps_done": {
      "description": "Ticked steps, each 'slot|step': slot is 'all' for an until-it's-done reminder (its ticks last until it's done), otherwise 'YYYY-MM-DD@HH:MM' (fresh each time it comes around). Newest last; older than a week is dropped",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "times": {
      "description": "Times, HH:MM in the family's own time (08:00, 20:00). Each gets a push and a Done button",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "visibility": {
      "default": "family",
      "description": "family = everyone in the family sees it and gets the push; private = only owner_user_id (\"Only me\")",
      "enum": [
        "family",
        "private"
      ],
      "type": "string"
    }
  },
  "required": [
    "medication_name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": {
                "$nin": [
                  "private"
                ]
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": {
                "$nin": [
                  "private"
                ]
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "$or": [
            {
              "data.visibility": {
                "$nin": [
                  "private"
                ]
              }
            },
            {
              "data.owner_user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}