{
  "name": "PreteenLog",
  "properties": {
    "allowance_type": {
      "enum": [
        "earn",
        "spend",
        "save"
      ],
      "type": "string"
    },
    "amount": {
      "description": "Allowance amount in dollars",
      "type": "number"
    },
    "anxiety_level": {
      "description": "Anxiety level 1-5",
      "type": "number"
    },
    "completed": {
      "default": false,
      "type": "boolean"
    },
    "cycle_start": {
      "format": "date",
      "type": "string"
    },
    "due_date": {
      "description": "Deadline for schoolwork",
      "format": "date",
      "type": "string"
    },
    "entry_type": {
      "default": "schoolwork",
      "enum": [
        "schoolwork",
        "chore",
        "puberty",
        "hygiene",
        "mental",
        "screen_time",
        "allowance",
        "social"
      ],
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "ID of the pre-teen",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "grade": {
      "description": "Grade received",
      "type": "string"
    },
    "hygiene_habit": {
      "enum": [
        "shower",
        "teeth",
        "deodorant"
      ],
      "type": "string"
    },
    "mood": {
      "enum": [
        "happy",
        "calm",
        "anxious",
        "irritable",
        "upset"
      ],
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "points": {
      "description": "Chore points or reward value",
      "type": "number"
    },
    "puberty_type": {
      "enum": [
        "menstrual",
        "acne",
        "growth"
      ],
      "type": "string"
    },
    "screen_time_min": {
      "type": "number"
    },
    "social_activity": {
      "enum": [
        "playdate",
        "sleepover"
      ],
      "type": "string"
    },
    "social_contact": {
      "description": "Friend's parent contact info",
      "type": "string"
    },
    "stress_trigger": {
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "description": "Title for schoolwork, chore, or social entries",
      "type": "string"
    }
  },
  "required": [
    "family_member_id",
    "entry_type"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}