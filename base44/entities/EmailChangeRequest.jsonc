{
  "name": "EmailChangeRequest",
  "properties": {
    "current_email": {
      "type": "string"
    },
    "requested_email": {
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "done",
        "rejected"
      ],
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "current_email",
    "requested_email",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}