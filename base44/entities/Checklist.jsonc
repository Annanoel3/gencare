{
  "name": "Checklist",
  "properties": {
    "category": {
      "default": "Other",
      "enum": [
        "Medication",
        "Meals",
        "School",
        "Personal Care",
        "Pet Care",
        "Elderly Care",
        "Other"
      ],
      "type": "string"
    },
    "color": {
      "description": "Accent color for the card",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "Which family member this checklist is for",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "reset_frequency": {
      "default": "daily",
      "description": "How often checklist items reset",
      "enum": [
        "daily",
        "weekly",
        "never"
      ],
      "type": "string"
    },
    "title": {
      "description": "Checklist name, e.g. Morning Routine",
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}