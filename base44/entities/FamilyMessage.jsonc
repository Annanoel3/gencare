{
  "name": "FamilyMessage",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_user_id": {
      "type": "string"
    },
    "category": {
      "default": "General",
      "enum": [
        "Update",
        "Announcement",
        "Question",
        "Care Update",
        "Visit Summary",
        "Photo",
        "Task",
        "General"
      ],
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "edited_at": {
      "format": "date-time",
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "The person this post is about, if any",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_pinned": {
      "default": false,
      "type": "boolean"
    },
    "parent_id": {
      "description": "Set on replies: the message this answers",
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "photos": {
      "description": "Private file URIs",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "task_id": {
      "description": "For task discussions: the CareTask",
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}