{
  "name": "FamilyMessage",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_user_id": {
      "type": "string"
    },
    "category": {
      "default": "General",
      "enum": [
        "Update",
        "Announcement",
        "Question",
        "Care Update",
        "Photo",
        "General"
      ],
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "family_member_id": {
      "description": "Related family member if applicable",
      "type": "string"
    },
    "family_member_name": {
      "type": "string"
    },
    "is_pinned": {
      "default": false,
      "type": "boolean"
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "read": {
      "data.family_id": "{{user.data.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.data.family_id}}"
    }
  },
  "type": "object"
}